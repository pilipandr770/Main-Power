# ---------- Docker / Produktion (docker-compose.prod.yml) ----------
DOMAIN=ai.main-power.org
POSTGRES_PASSWORD=bitte-langes-zufaelliges-passwort
# SEED=1 legt beim Start Inhalte + Superadmin an (nur wenn leer); SEED_DEMO=1 zusätzlich Demo-Mitglieder
SEED=1
SEED_DEMO=0
# 1 = nur Caddy davor; 2 = Cloudflare-Proxy + Caddy
PROXY_HOPS=1
# Nur für Cloudflare Tunnel (--profile tunnel)
CLOUDFLARE_TUNNEL_TOKEN=

# ---------- Basis ----------
FLASK_APP=wsgi.py
FLASK_ENV=production
SECRET_KEY=bitte-mit-python-c-import-secrets-print-secrets.token_hex-32-erzeugen
BASE_URL=https://ai.main-power.org
DATABASE_URL=postgresql://mainpower:PASSWORT@localhost:5432/mainpower
COOKIE_SECURE=1
LOG_LEVEL=INFO
# Mehrere Gunicorn-Worker -> gemeinsamer Speicher für Rate-Limits (optional)
# RATELIMIT_STORAGE_URI=redis://localhost:6379/3

# ---------- Erster Superadmin (nur für `flask seed`) ----------
ADMIN_EMAIL=hallo@main-power.org
ADMIN_PASSWORD=sofort-aendern-mindestens-10-zeichen

# ---------- KI ----------
ANTHROPIC_API_KEY=
# Günstiges Modell (Standard). Preise in USD je 1 Mio. Token nur für die Kostenanzeige im Admin.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
LLM_PRICE_IN=1.0
LLM_PRICE_OUT=5.0
# auto = voyage > openai > local (Hashing, offline)
EMBEDDING_PROVIDER=auto
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3.5
OPENAI_API_KEY=
OPENAI_EMBED_MODEL=text-embedding-3-small

# ---------- Gesetzes-Suche (internes Nachbarprojekt "laws_pipeline": Qdrant + Bundesrecht-Korpus) ----------
# Nur intern über das Docker-Netzwerk "laws_net" erreichbar, kein öffentlicher Port. Leer = Funktion ausgeblendet.
LAWS_API_URL=http://laws-api:8000

# ---------- Termine von main-power.org ----------
EVENTS_SYNC_URL=https://www.main-power.org/api/events

# ---------- Telegram (Community-Chat + Aiko-Bot) ----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# ID der Supergruppe, z. B. -1001234567890 (Bot als Admin: Mitglieder einladen + sperren)
TELEGRAM_GROUP_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=zufaelliger-string-a-z-0-9

# ---------- Stripe (Feature-Flag) ----------
STRIPE_ENABLED=0
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---------- E-Mail (leer = Mails nur ins Log) ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Main Power <hallo@main-power.org>
SMTP_TLS=1

# ---------- Rechtliches ----------
CONTACT_EMAIL=hallo@main-power.org
MAIN_SITE_URL=https://www.main-power.org
IMPRESSUM_URL=https://www.main-power.org/impressum
CONSENT_VERSION=2026-09

# Demo-Modus: Admins dürfen zwischen Mitgliedskonten wechseln. In Produktion NICHT setzen.
# ENABLE_IMPERSONATION=1
