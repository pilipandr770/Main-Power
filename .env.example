# ---------- Docker / Produktion (docker-compose.prod.yml) ----------
DOMAIN=klub.example.org
POSTGRES_PASSWORD=bitte-langes-zufaelliges-passwort
# SEED=1 legt beim Start Inhalte + Superadmin an (nur wenn leer); SEED_DEMO=1 zusätzlich Demo-Mitglieder
SEED=1
SEED_DEMO=0
# 1 = nur Caddy davor; 2 = Cloudflare-Proxy + Caddy
PROXY_HOPS=1
# Nur für Cloudflare Tunnel (--profile tunnel)
CLOUDFLARE_TUNNEL_TOKEN=

# ---------- Basis ----------
FLASK_APP=wsgi.py
FLASK_ENV=production
SECRET_KEY=bitte-mit-python-c-import-secrets-print-secrets.token_hex-32-erzeugen
BASE_URL=https://klub.example.org
DATABASE_URL=postgresql://mainpower:PASSWORT@localhost:5432/mainpower
COOKIE_SECURE=1
LOG_LEVEL=INFO
# Mehrere Gunicorn-Worker -> gemeinsamer Speicher für Rate-Limits (optional)
# RATELIMIT_STORAGE_URI=redis://localhost:6379/3

# ---------- Erster Superadmin (nur für `flask seed`) ----------
ADMIN_EMAIL=admin@klub.example.org
ADMIN_PASSWORD=sofort-aendern-mindestens-10-zeichen

# ---------- KI ----------
ANTHROPIC_API_KEY=
# Günstiges Modell (Standard). Preise in USD je 1 Mio. Token nur für die Kostenanzeige im Admin.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
LLM_PRICE_IN=1.0
LLM_PRICE_OUT=5.0
# auto = voyage > openai > local (Hashing, offline)
EMBEDDING_PROVIDER=auto
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3.5
OPENAI_API_KEY=
OPENAI_EMBED_MODEL=text-embedding-3-small

# ---------- Gesetzes-Suche (internes Nachbarprojekt "laws_pipeline": Qdrant + Bundesrecht-Korpus) ----------
# Nur intern über das Docker-Netzwerk "laws_net" erreichbar, kein öffentlicher Port. Leer = Funktion ausgeblendet.
LAWS_API_URL=http://laws-api:8000

# ---------- Termin-Import (optional; je Klub auch in den Klub-Einstellungen) ----------
EVENTS_SYNC_URL=

# ---------- Telegram (Community-Chat + Aiko-Bot) ----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# ID der Supergruppe, z. B. -1001234567890 (Bot als Admin: Mitglieder einladen + sperren)
TELEGRAM_GROUP_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=zufaelliger-string-a-z-0-9

# ---------- Stripe (Feature-Flag) ----------
STRIPE_ENABLED=0
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Tarife/Abos: Webhook-Endpunkt https://<domain>/webhooks/stripe mit den Ereignissen
# checkout.session.completed, checkout.session.async_payment_succeeded, customer.subscription.created,
# customer.subscription.updated, customer.subscription.deleted, invoice.paid, invoice.payment_failed
STRIPE_PUBLISHABLE_KEY=

# ---------- E-Mail (leer = Mails nur ins Log) ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Klub <kontakt@klub.example.org>
SMTP_TLS=1

# ---------- Rechtliches ----------
CONTACT_EMAIL=kontakt@klub.example.org
MAIN_SITE_URL=
IMPRESSUM_URL=
CONSENT_VERSION=2026-09

# Demo-Modus: Admins dürfen zwischen Mitgliedskonten wechseln. In Produktion NICHT setzen.
# ENABLE_IMPERSONATION=1

# ---------- Mehrere Klubs (SaaS) ----------
# Standardklub (bestehende Daten landen hier). Weitere Klubs: `flask create-club` oder Konsole /plattform.
DEFAULT_CLUB_SLUG=klub
DEFAULT_CLUB_NAME=Klub
# Eigene Domains des Standardklubs, kommagetrennt (z. B. klub.example.org)
DEFAULT_CLUB_DOMAINS=
# Klubs ohne eigene Domain erreichbar als <slug>.<PLATFORM_DOMAIN> (Wildcard-DNS + Zertifikat nötig)
PLATFORM_DOMAIN=
# 1 = unbekannte Hosts bekommen 404 statt Standardklub
STRICT_HOSTS=0
# Betreiber-Konsole /plattform — ohne beide Werte ist sie abgeschaltet. Passwort gern als werkzeug-Hash.
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
