# /etc/systemd/system/mainpower.service
[Unit]
Description=Main Power Plattform (Gunicorn)
After=network.target postgresql.service

[Service]
User=www-data
Group=www-data
WorkingDirectory=/srv/mainpower
EnvironmentFile=/srv/mainpower/.env
ExecStart=/srv/mainpower/.venv/bin/gunicorn -w 3 -k gthread --threads 4 --timeout 90 -b 127.0.0.1:8010 wsgi:app
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
